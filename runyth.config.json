{
  "build": {
    "exclude": [
      "**/*.map",
      "**/*.ts",
      "**/*.tsx",
      "**/.DS_Store",
      "**/Thumbs.db"
    ],
    "include": [
      "module.json",
      "README.md",
      "CHANGELOG.md",
      "LICENSE",
      "scripts/**",
      "styles/**",
      "templates/**",
      "lang/**",
      "packs/**",
      "assets/**",
      "data/**",
      "fonts/**",
      "icons/**",
      "media/**",
      "sounds/**",
      "ui/**",
      "vendor/**"
    ],
    "preBuild": [],
    "sourceExclude": [
      ".git/**",
      ".runyth-template-source/**",
      "dist/**",
      "node_modules/**",
      "coverage/**",
      ".nyc_output/**",
      ".cache/**",
      "*.log",
      ".env",
      ".env.*",
      "**/.DS_Store",
      "**/Thumbs.db"
    ]
  },
  "format": {
    "exclude": [
      "runtime/**",
      "module.json"
    ]
  },
  "module": {
    "kind": "runtime",
    "publicApi": true,
    "repository": "Runyth/foundry-runyth-order",
    "systemNeutral": true
  },
  "runtimeKit": {
    "managed": false
  },
  "schemaVersion": 1,
  "sync": {
    "exclude": [
      "tools/build.mjs",
      "tools/validate.mjs",
      "tools/verify-release.mjs",
      "tools/lib/zip.mjs",
      "test/runyth/zip.test.mjs",
      "package.json#scripts.check",
      "docs/MODULE_ADOPTION_MATRIX.md"
    ]
  },
  "template": {
    "repository": "Runyth/template-foundry-module",
    "source": false,
    "version": "1.1.6"
  },
  "validation": {
    "allowFindings": [],
    "forbidPrivateFoundryApis": true,
    "forbidSourceMaps": true,
    "requireLocaleParity": false,
    "requireRepositoryUrls": true,
    "requireVersionParity": true,
    "requiredLocales": [
      "en"
    ]
  }
}
