{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runyth.github.io/schemas/runyth-order/provider-registration-v1.json",
  "title": "Runyth Order provider registration input",
  "description": "Validates the object passed to RunythOrderApi.registerProvider. It describes registration intent: pack IDs are provider-local, generated identities (global pack IDs, localId, providerId) and runtime defaults are intentionally absent here. Unknown keys are permitted because Runyth Order ignores them at registration time. The normalized output contract is schemas/provider-descriptor.schema.json.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "title",
    "coreApi"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/id"
    },
    "moduleId": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "coreApi": {
      "$ref": "#/$defs/coreCompatibility"
    },
    "systems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/systemDeclaration"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependencyDeclaration"
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
      }
    },
    "packs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/packDeclaration"
      }
    },
    "validators": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "migrations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "documentationUrl": {
      "type": "string"
    },
    "repositoryUrl": {
      "type": "string"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "naming": {
      "oneOf": [
        {
          "$ref": "#/$defs/naming"
        },
        {
          "type": "null"
        }
      ]
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "versionPattern": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^v?\\d+(?:\\.\\d+){0,2}(?:[-+].*)?$"
    },
    "coreCompatibility": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "minimum": {
          "$ref": "#/$defs/versionPattern"
        },
        "verified": {
          "$ref": "#/$defs/versionPattern"
        },
        "maximum": {
          "$ref": "#/$defs/versionPattern"
        }
      },
      "anyOf": [
        {
          "required": [
            "minimum"
          ],
          "properties": {
            "minimum": {
              "type": "string"
            }
          }
        },
        {
          "required": [
            "maximum"
          ],
          "properties": {
            "maximum": {
              "type": "string"
            }
          }
        }
      ]
    },
    "systemDeclaration": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "minimum": {
          "$ref": "#/$defs/versionPattern"
        },
        "verified": {
          "$ref": "#/$defs/versionPattern"
        },
        "maximum": {
          "$ref": "#/$defs/versionPattern"
        }
      }
    },
    "dependencyDeclaration": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "moduleId"
      ],
      "properties": {
        "moduleId": {
          "$ref": "#/$defs/id"
        },
        "required": {
          "type": "boolean"
        },
        "minimum": {
          "$ref": "#/$defs/versionPattern"
        },
        "verified": {
          "$ref": "#/$defs/versionPattern"
        },
        "maximum": {
          "$ref": "#/$defs/versionPattern"
        }
      }
    },
    "packDeclaration": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "systemId": {
          "type": "string"
        },
        "contentKinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "compendia": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entryDeclaration"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependencyDeclaration"
          }
        },
        "documentationUrl": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "entryDeclaration": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "title",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "background",
            "class",
            "equipment",
            "feature",
            "feat",
            "species",
            "spell",
            "subclass",
            "condition",
            "macro",
            "other"
          ]
        },
        "uuid": {
          "type": "string"
        },
        "identifier": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "naming": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "orderName",
        "moduleKind",
        "contentName",
        "canonicalTitle"
      ],
      "properties": {
        "orderName": {
          "const": "Runyth Order"
        },
        "moduleKind": {
          "type": "string",
          "minLength": 1
        },
        "contentName": {
          "type": "string",
          "minLength": 1
        },
        "canonicalTitle": {
          "type": "string",
          "minLength": 1,
          "pattern": "^Runyth Order: .+ .+$"
        }
      }
    }
  }
}
