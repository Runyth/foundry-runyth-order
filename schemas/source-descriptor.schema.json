{
  "$id": "https://runyth.github.io/schemas/runyth-order/source-descriptor-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checksum": {
      "type": [
        "string",
        "null"
      ]
    },
    "contentVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "entryId": {
      "minLength": 1,
      "type": "string"
    },
    "importedAt": {
      "format": "date-time",
      "type": "string"
    },
    "packId": {
      "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$",
      "type": "string"
    },
    "providerId": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "sourceUuid": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "providerId",
    "packId",
    "entryId",
    "sourceUuid",
    "contentVersion",
    "checksum",
    "importedAt"
  ],
  "title": "Runyth Order managed source",
  "type": "object"
}
