{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runyth.github.io/runyth-order/schemas/localization-pack.schema.json",
  "title": "Runyth Order localization-pack metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "targetModuleId",
    "targetModuleVersion",
    "baseLanguage",
    "language",
    "namespace"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "targetModuleId": {
      "const": "runyth-order"
    },
    "targetModuleVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "baseLanguage": {
      "const": "en"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]+)*$"
    },
    "namespace": {
      "const": "RO"
    }
  }
}
