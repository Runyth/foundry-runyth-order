{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runyth.github.io/schemas/runyth-order/audit-report-v1.json",
  "title": "Runyth Order Actor audit report",
  "description": "Validates the output returned by auditActor. The report uses the startedAt/completedAt timestamp contract; see docs/API.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "actor",
    "startedAt",
    "completedAt",
    "counts",
    "issues",
    "providerRuns"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "actor": {
      "type": "object",
      "required": [
        "uuid",
        "id",
        "name",
        "type"
      ],
      "properties": {
        "uuid": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      }
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "counts": {
      "type": "object",
      "required": [
        "info",
        "warning",
        "error"
      ],
      "properties": {
        "info": {
          "type": "integer",
          "minimum": 0
        },
        "warning": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "providerId",
          "severity",
          "code",
          "title",
          "message",
          "remediation",
          "documentUuid",
          "data"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "providerId": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "code": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "remediation": {
            "type": [
              "string",
              "null"
            ]
          },
          "documentUuid": {
            "type": [
              "string",
              "null"
            ]
          },
          "data": {
            "type": "object"
          }
        }
      }
    },
    "providerRuns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "validatorId",
          "status",
          "issueCount",
          "durationMs"
        ],
        "properties": {
          "validatorId": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "failed"
            ]
          },
          "issueCount": {
            "type": "integer",
            "minimum": 0
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0
          },
          "error": {
            "type": "object",
            "required": [
              "name",
              "message",
              "stack"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "stack": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
