{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runyth.github.io/schemas/runyth-rules-core/provider-descriptor-v1.json",
  "title": "Runyth Order provider descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "moduleId",
    "title",
    "version",
    "coreApi",
    "systems",
    "dependencies",
    "capabilities",
    "packs"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/id"
    },
    "moduleId": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "coreApi": {
      "$ref": "#/$defs/coreCompatibility"
    },
    "systems": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/compatibility"
          },
          {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              }
            }
          }
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/compatibility"
          },
          {
            "type": "object",
            "required": [
              "moduleId",
              "required"
            ],
            "properties": {
              "moduleId": {
                "$ref": "#/$defs/id"
              },
              "required": {
                "type": "boolean"
              }
            }
          }
        ]
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
      }
    },
    "packs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pack"
      }
    },
    "documentationUrl": {
      "type": [
        "string",
        "null"
      ]
    },
    "repositoryUrl": {
      "type": [
        "string",
        "null"
      ]
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "naming": {
      "oneOf": [
        {
          "$ref": "#/$defs/naming"
        },
        {
          "type": "null"
        }
      ]
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^v?\\d+(?:\\.\\d+){0,2}(?:[-+].*)?$"
        },
        "verified": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^v?\\d+(?:\\.\\d+){0,2}(?:[-+].*)?$"
        },
        "maximum": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^v?\\d+(?:\\.\\d+){0,2}(?:[-+].*)?$"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "background",
            "class",
            "equipment",
            "feature",
            "feat",
            "species",
            "spell",
            "subclass",
            "condition",
            "macro",
            "other"
          ]
        },
        "uuid": {
          "type": [
            "string",
            "null"
          ]
        },
        "identifier": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "localId",
        "providerId",
        "title",
        "contentKinds",
        "compendia",
        "entries",
        "dependencies"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$"
        },
        "localId": {
          "$ref": "#/$defs/id"
        },
        "providerId": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "systemId": {
          "type": [
            "string",
            "null"
          ]
        },
        "contentKinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "compendia": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "dependencies": {
          "type": "array"
        },
        "documentationUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "coreCompatibility": {
      "allOf": [
        {
          "$ref": "#/$defs/compatibility"
        },
        {
          "anyOf": [
            {
              "required": [
                "minimum"
              ],
              "properties": {
                "minimum": {
                  "type": "string"
                }
              }
            },
            {
              "required": [
                "maximum"
              ],
              "properties": {
                "maximum": {
                  "type": "string"
                }
              }
            }
          ]
        }
      ]
    },
    "naming": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orderName",
        "moduleKind",
        "contentName",
        "canonicalTitle"
      ],
      "properties": {
        "orderName": {
          "const": "Runyth Order"
        },
        "moduleKind": {
          "type": "string",
          "minLength": 1
        },
        "contentName": {
          "type": "string",
          "minLength": 1
        },
        "canonicalTitle": {
          "type": "string",
          "minLength": 1,
          "pattern": "^Runyth Order: .+ .+$"
        }
      }
    }
  }
}
