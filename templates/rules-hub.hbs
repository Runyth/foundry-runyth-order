<div class="ro-shell" data-busy="{{busy}}">
  <header class="ro-header">
    <div>
      <p class="ro-eyebrow">RUNYTH</p>
      <h1>{{localize "RO.Title"}}</h1>
      <p>{{localize "RO.Hub.Subtitle"}}</p>
    </div>
    <div class="ro-header-actions">
      <button type="button" data-action="refresh" {{#if busy}}disabled{{/if}} title="{{localize 'RO.Actions.Refresh'}}">
        <i class="fa-solid fa-arrows-rotate"></i>
        <span>{{localize "RO.Actions.Refresh"}}</span>
      </button>
      <button type="button" data-action="reset-position" {{#if busy}}disabled{{/if}} title="{{localize 'RO.Actions.ResetPosition'}}">
        <i class="fa-solid fa-window-restore"></i>
        <span>{{localize "RO.Actions.ResetPosition"}}</span>
      </button>
    </div>
  </header>

  <nav class="ro-tabs" aria-label="{{localize 'RO.Hub.Navigation'}}">
    <button type="button" data-tab="overview" {{#if busy}}disabled{{/if}} class="{{#if tabs.overview}}active{{/if}}">
      <i class="fa-solid fa-gauge-high"></i> {{localize "RO.Tabs.Overview"}}
    </button>
    <button type="button" data-tab="providers" {{#if busy}}disabled{{/if}} class="{{#if tabs.providers}}active{{/if}}">
      <i class="fa-solid fa-puzzle-piece"></i> {{localize "RO.Tabs.Providers"}}
      <span class="ro-count">{{providerCount}}</span>
    </button>
    <button type="button" data-tab="packs" {{#if busy}}disabled{{/if}} class="{{#if tabs.packs}}active{{/if}}">
      <i class="fa-solid fa-box-archive"></i> {{localize "RO.Tabs.Packs"}}
      <span class="ro-count">{{packCount}}</span>
    </button>
    <button type="button" data-tab="audit" {{#if busy}}disabled{{/if}} class="{{#if tabs.audit}}active{{/if}}">
      <i class="fa-solid fa-user-check"></i> {{localize "RO.Tabs.Audit"}}
    </button>
    <button type="button" data-tab="diagnostics" {{#if busy}}disabled{{/if}} class="{{#if tabs.diagnostics}}active{{/if}}">
      <i class="fa-solid fa-stethoscope"></i> {{localize "RO.Tabs.Diagnostics"}}
    </button>
  </nav>

  <main class="ro-content">
    {{#if busy}}
      <div class="ro-busy" role="status">
        <i class="fa-solid fa-spinner fa-spin"></i>
        {{localize "RO.Hub.Working"}}
      </div>
    {{/if}}

    {{#if tabs.overview}}
      <section class="ro-panel">
        <div class="ro-stat-grid">
          <article><strong>{{providerCount}}</strong><span>{{localize "RO.Stats.Providers"}}</span></article>
          <article><strong>{{packCount}}</strong><span>{{localize "RO.Stats.Packs"}}</span></article>
          <article><strong>{{validatorCount}}</strong><span>{{localize "RO.Stats.Validators"}}</span></article>
          <article><strong>{{pendingMigrationCount}}</strong><span>{{localize "RO.Stats.PendingMigrations"}}</span></article>
        </div>

        <div class="ro-callout">
          <i class="fa-solid fa-shield-halved"></i>
          <div>
            <h2>{{localize "RO.Overview.BoundaryTitle"}}</h2>
            <p>{{localize "RO.Overview.BoundaryBody"}}</p>
          </div>
        </div>

        <div class="ro-two-column">
          <article>
            <h2>{{localize "RO.Overview.Capabilities"}}</h2>
            <div class="ro-capability-grid">
              {{#each capabilities}}
                <div class="ro-capability {{#if available}}available{{/if}}">
                  <i class="fa-solid {{#if available}}fa-circle-check{{else}}fa-circle-minus{{/if}}"></i>
                  <code>{{id}}</code>
                </div>
              {{/each}}
            </div>
          </article>
          <article>
            <h2>{{localize "RO.Overview.Runtime"}}</h2>
            <dl class="ro-definition-list">
              <dt>{{localize "RO.Overview.ApiVersion"}}</dt><dd>{{apiVersion}}</dd>
              <dt>{{localize "RO.Overview.SchemaVersion"}}</dt><dd>{{dataSchemaVersion}}</dd>
              <dt>{{localize "RO.Overview.RegisteredMigrations"}}</dt><dd>{{migrationCount}}</dd>
            </dl>
          </article>
        </div>
      </section>
    {{/if}}

    {{#if tabs.providers}}
      <section class="ro-panel">
        <h2>{{localize "RO.Providers.Title"}}</h2>
        <p>{{localize "RO.Providers.Help"}}</p>
        {{#if providerRows.length}}
          <div class="ro-card-list">
            {{#each providerRows}}
              <article class="ro-card">
                <header>
                  <div>
                    <h3>{{title}}</h3>
                    <code>{{id}}</code>
                  </div>
                  <span class="ro-version">v{{version}}</span>
                </header>
                {{#if description}}<p>{{description}}</p>{{/if}}
                {{#if namingFindings.length}}
                  <div class="ro-provider-naming" aria-label="{{localize 'RO.Providers.Naming'}}">
                    {{#each namingFindings}}
                      <div class="ro-naming-finding {{cssClass}}">
                        <i class="fa-solid fa-circle-info"></i>
                        <div>
                          <strong>{{localize "RO.Naming.ContractLabel"}}</strong>
                          <p>{{message}}</p>
                          <code>{{code}}</code>
                        </div>
                      </div>
                    {{/each}}
                  </div>
                {{/if}}
                <dl class="ro-definition-list compact">
                  <dt>{{localize "RO.Providers.Module"}}</dt><dd><code>{{moduleId}}</code></dd>
                  <dt>{{localize "RO.Providers.Systems"}}</dt><dd>{{systemSummary}}</dd>
                  <dt>{{localize "RO.Providers.Capabilities"}}</dt><dd>{{capabilitySummary}}</dd>
                  <dt>{{localize "RO.Providers.Contributions"}}</dt>
                  <dd>{{packCount}} {{localize "RO.Stats.Packs"}}, {{validatorCount}} {{localize "RO.Stats.Validators"}}, {{migrationCount}} {{localize "RO.Providers.Migrations"}}</dd>
                </dl>
              </article>
            {{/each}}
          </div>
        {{else}}
          <div class="ro-empty">{{localize "RO.Providers.Empty"}}</div>
        {{/if}}
      </section>
    {{/if}}

    {{#if tabs.packs}}
      <section class="ro-panel">
        <h2>{{localize "RO.Packs.Title"}}</h2>
        <p>{{localize "RO.Packs.Help"}}</p>
        {{#if packRows.length}}
          <div class="ro-card-list">
            {{#each packRows}}
              <article class="ro-card">
                <header>
                  <div><h3>{{title}}</h3><code>{{id}}</code></div>
                  {{#if version}}<span class="ro-version">v{{version}}</span>{{/if}}
                </header>
                {{#if description}}<p>{{description}}</p>{{/if}}
                <dl class="ro-definition-list compact">
                  <dt>{{localize "RO.Packs.Provider"}}</dt><dd><code>{{providerId}}</code></dd>
                  <dt>{{localize "RO.Packs.Kinds"}}</dt><dd>{{kindSummary}}</dd>
                  <dt>{{localize "RO.Packs.Compendia"}}</dt><dd>{{compendiumSummary}}</dd>
                  <dt>{{localize "RO.Packs.Entries"}}</dt><dd>{{entryCount}}</dd>
                </dl>
              </article>
            {{/each}}
          </div>
        {{else}}
          <div class="ro-empty">{{localize "RO.Packs.Empty"}}</div>
        {{/if}}
      </section>
    {{/if}}

    {{#if tabs.audit}}
      <section class="ro-panel">
        <h2>{{localize "RO.Audit.Title"}}</h2>
        <p>{{localize "RO.Audit.Help"}}</p>
        {{#if actor}}
          <div class="ro-actor-row">
            <img src="{{actor.img}}" alt="" />
            <div><strong>{{actor.name}}</strong><code>{{actor.uuid}}</code></div>
            <button type="button" data-action="audit" {{#if actor.auditDisabled}}disabled{{/if}}>
              <i class="fa-solid fa-magnifying-glass-chart"></i>
              {{localize "RO.Actions.AuditActor"}}
            </button>
          </div>
        {{else}}
          <div class="ro-empty">{{actorSelectionMessage}}</div>
        {{/if}}

        {{#if auditReport}}
          <div class="ro-result-summary">
            <span class="danger">{{auditReport.counts.error}} {{localize "RO.Severity.Errors"}}</span>
            <span class="warning">{{auditReport.counts.warning}} {{localize "RO.Severity.Warnings"}}</span>
            <span class="info">{{auditReport.counts.info}} {{localize "RO.Severity.Info"}}</span>
          </div>
          {{#if auditReport.issues.length}}
            <div class="ro-findings">
              {{#each auditReport.issues}}
                <article class="ro-finding {{cssClass}}">
                  <header><strong>{{title}}</strong><code>{{providerId}} · {{code}}</code></header>
                  <p>{{message}}</p>
                  {{#if remediation}}<p class="ro-remediation"><i class="fa-solid fa-screwdriver-wrench"></i> {{remediation}}</p>{{/if}}
                </article>
              {{/each}}
            </div>
          {{else}}
            <div class="ro-success"><i class="fa-solid fa-circle-check"></i> {{localize "RO.Audit.Clean"}}</div>
          {{/if}}
        {{/if}}
      </section>
    {{/if}}

    {{#if tabs.diagnostics}}
      <section class="ro-panel">
        <div class="ro-section-heading">
          <div><h2>{{localize "RO.Diagnostics.Title"}}</h2><p>{{localize "RO.Diagnostics.Help"}}</p></div>
          <div class="ro-button-group">
            <button type="button" data-action="diagnostics" data-deep="false" {{#if busy}}disabled{{/if}}>
              <i class="fa-solid fa-stethoscope"></i> {{localize "RO.Actions.RunDiagnostics"}}
            </button>
            <button type="button" data-action="diagnostics" data-deep="true" {{#if busy}}disabled{{/if}}>
              <i class="fa-solid fa-microscope"></i> {{localize "RO.Actions.RunDeepDiagnostics"}}
            </button>
          </div>
        </div>

        {{#if pendingMigrations.length}}
          <div class="ro-callout warning">
            <i class="fa-solid fa-database"></i>
            <div>
              <h3>{{localize "RO.Migrations.PendingTitle"}}</h3>
              <p><strong>{{pendingMigrationCount}}</strong> {{localize "RO.Migrations.PendingBody"}}</p>
              {{#if isGM}}
                <button type="button" data-action="run-migrations" {{#if busy}}disabled{{/if}}>
                  <i class="fa-solid fa-play"></i> {{localize "RO.Actions.RunMigrations"}}
                </button>
              {{/if}}
            </div>
          </div>
        {{/if}}

        {{#if diagnosticsReport}}
          <div class="ro-result-summary">
            <span class="danger">{{diagnosticsReport.counts.error}} {{localize "RO.Severity.Errors"}}</span>
            <span class="warning">{{diagnosticsReport.counts.warning}} {{localize "RO.Severity.Warnings"}}</span>
            <span class="info">{{diagnosticsReport.counts.info}} {{localize "RO.Severity.Info"}}</span>
            <button type="button" data-action="copy-diagnostics" {{#if busy}}disabled{{/if}}><i class="fa-solid fa-copy"></i> {{localize "RO.Actions.CopyJson"}}</button>
          </div>
          {{#if diagnosticsReport.findings.length}}
            <div class="ro-findings">
              {{#each diagnosticsReport.findings}}
                <article class="ro-finding {{cssClass}}">
                  <header><strong>{{code}}</strong>{{#if providerId}}<code>{{providerId}}{{#if packId}} · {{packId}}{{/if}}</code>{{/if}}</header>
                  <p>{{message}}</p>
                </article>
              {{/each}}
            </div>
          {{else}}
            <div class="ro-success"><i class="fa-solid fa-circle-check"></i> {{localize "RO.Diagnostics.Clean"}}</div>
          {{/if}}
        {{/if}}
      </section>
    {{/if}}
  </main>
</div>
